{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wolfbet-cli-last-bets-v1.json",
  "title": "wolfbet.py --last-bets N --json",
  "description": "The newest N bets across all sessions, newest first.",
  "oneOf": [
    {
      "$ref": "#/$defs/ok"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "ok": {
      "type": "object",
      "required": [
        "v",
        "bets"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "bets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "session_id",
              "timestamp",
              "amount",
              "result_value",
              "state",
              "profit",
              "balance_after"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "session_id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "timestamp": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "amount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "result_value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "profit": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "balance_after": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "v",
        "error"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "no_database"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
