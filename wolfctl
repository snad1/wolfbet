#!/usr/bin/env bash
# WolfBet AutoBot — Unified Management Command v3.11
# Wrapped in { } so bash reads entire script before executing —
# prevents corruption when cmd_update replaces this file mid-run.
{
set -euo pipefail

INSTALL_DIR="$HOME/wolfbet-bot"
WEB_DIR="$HOME/wolfbet-web"
SERVICE="wolfbet"
TG_SERVICE="wolfbet-tg"
WEB_SERVICE="wolfbet-web"
# v3.10 — parallel lanes: lane 1 = $SERVICE, lanes 2..N = wolfbet-lane@K
# v3.11 — wolfctl lanes N --split none|budget|bet|both
LANE_SERVICE="wolfbet-lane"
LANES_MAX=10
SYSTEMD_DIR="$HOME/.config/systemd/user"
PYTHON="$INSTALL_DIR/venv/bin/python3"
BOT="$INSTALL_DIR/wolfbet.py"
ENV_FILE="$INSTALL_DIR/.env"
SCRIPT_NAME="wolfctl"
# v3.9 — surface installed-vs-repo drift so operators stuck on an old
# wolfctl (from before the self-copy block landed) see a warning instead
# of a silent "already up to date". This constant is grep-parsed by
# cmd_update's drift check — keep the format `WOLFCTL_VERSION=X.Y`.
WOLFCTL_VERSION=3.11

