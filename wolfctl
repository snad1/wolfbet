    echo ""
    echo "  CONFIG:"
    echo "    wolfctl config-show                    Show current config (API key masked)"
    echo "    wolfctl config-set KEY=VALUE [K=V …]   Non-interactive tweak (delay=0.35, maxprofit=0.005, …)"
