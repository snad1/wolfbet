# ── CLI bot commands ──────────────────────────────────
cmd_setup() {
    echo "Running setup wizard…"
    "$PYTHON" "$BOT" --setup-only
}

# ── v3.10 — parallel lanes ─────────────────────────────
# Configured lane count from the config file (1 when unset / unreadable).
lane_count() {
    "$PYTHON" - "$HOME/.wolfbet_autobot.json" <<'PY' 2>/dev/null || echo 1
import json, sys
try:
    n = int((json.load(open(sys.argv[1])).get("lanes") or {}).get("count") or 1)
except Exception:
    n = 1
print(max(1, min(10, n)))
PY
}

# Write the systemd template for lanes 2..N (same unit as lane 1 + --lane %i).
ensure_lane_unit() {
    local unit="$SYSTEMD_DIR/${LANE_SERVICE}@.service"
    [ -f "$unit" ] && grep -q -- '--lane %i' "$unit" && grep -q '^WantedBy=' "$unit" && return 0
    mkdir -p "$SYSTEMD_DIR"
    cat > "$unit" << UNITEOF
[Unit]
Description=WolfBet AutoBot — parallel lane %i (CLI)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0
WorkingDirectory=${INSTALL_DIR}
ExecStart=${INSTALL_DIR}/venv/bin/python3 ${INSTALL_DIR}/wolfbet.py --resume --daemon --lane %i
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

KillSignal=SIGTERM
TimeoutStopSec=15

Environment=HOME=${HOME}
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-${ENV_FILE}

[Install]
WantedBy=default.target
UNITEOF
    systemctl --user daemon-reload
}

# Start lanes 2..count; stop every lane above count.
sync_lanes() {
    local n="$1" k
    if [ "$n" -gt 1 ]; then
        ensure_lane_unit
    fi
    for k in $(seq 2 "$LANES_MAX"); do
        if [ "$k" -le "$n" ]; then
            # enable → lanes come back after a reboot together with lane 1
            systemctl --user enable --now "${LANE_SERVICE}@${k}" >/dev/null 2>&1 || true
        elif systemctl --user is-enabled --quiet "${LANE_SERVICE}@${k}" 2>/dev/null \
                || systemctl --user is-active --quiet "${LANE_SERVICE}@${k}" 2>/dev/null; then
            systemctl --user disable --now "${LANE_SERVICE}@${k}" >/dev/null 2>&1 || true
            echo "  lane $k stopped"
        fi
    done
}

stop_all_lanes() {
    local k
    for k in $(seq 2 "$LANES_MAX"); do
        systemctl --user stop "${LANE_SERVICE}@${k}" 2>/dev/null || true
    done
}

lane_split_mode() {
    "$PYTHON" -c 'import json,os,sys
try:
    d=json.load(open(os.path.expanduser("~/.wolfbet_autobot.json")))
    print((d.get("lanes") or {}).get("split") or "none")
except Exception:
    print("none")' 2>/dev/null || echo none
}

cmd_lanes() {
    local n="${1:-}" split=""
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --split) split="${2:-}"; shift 2 || { echo "Usage: wolfctl lanes N --split none|budget|bet|both"; exit 1; } ;;
            --split=*) split="${1#--split=}"; shift ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
    done
    if [ -n "$split" ]; then
        case "$split" in none|budget|bet|both) ;; *) echo "--split must be none, budget, bet or both"; exit 1 ;; esac
    fi
    if [ -z "$n" ]; then
        echo "Configured lanes: $(lane_count)"
        "$PYTHON" "$BOT" --lanes-status 2>/dev/null || true
        echo "  Split: $(lane_split_mode)"
        echo "  Change with: wolfctl lanes N [--split none|budget|bet|both]   (1-$LANES_MAX)"
        return
    fi
    case "$n" in ''|*[!0-9]*) echo "Usage: wolfctl lanes N  (1-$LANES_MAX)"; exit 1 ;; esac
    if [ "$n" -lt 1 ] || [ "$n" -gt "$LANES_MAX" ]; then
        echo "lanes must be 1-$LANES_MAX"; exit 1
    fi
    if [ -n "$split" ]; then
        "$PYTHON" "$BOT" --config-set "lanes=$n" "lane_split=$split" >/dev/null
    else
        "$PYTHON" "$BOT" --config-set "lanes=$n" >/dev/null
    fi
    echo "Lanes set to $n — split: $(lane_split_mode)."
    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        # Restart every lane so each recomputes its budget share.
        echo "Restarting lanes (each running chain is saved and ended)…"
        stop_all_lanes
        systemctl --user restart "$SERVICE"
        sync_lanes "$n"
        sleep 2
        "$PYTHON" "$BOT" --lanes-status 2>/dev/null || true
    else
        echo "Bot not running — start all $n lane(s) with: wolfctl start"
    fi
}

cmd_start() {
    if [ ! -f "$HOME/.wolfbet_autobot.json" ]; then
        echo "No config found. Run 'wolfctl setup' first."
        exit 1
    fi
    systemctl --user start "$SERVICE"
    sleep 1
    if systemctl --user is-active --quiet "$SERVICE"; then
        local n
        n=$(lane_count)
        sync_lanes "$n"
        if [ "$n" -gt 1 ]; then
            echo "CLI bot started with $n lanes."
        else
            echo "CLI bot started."
        fi
        echo "  Check: wolfctl status"
        echo "  Logs:  wolfctl logs"
    else
        echo "Failed to start. Check: wolfctl logs-full"
        exit 1
    fi
}

cmd_stop() {
    stop_all_lanes
    systemctl --user stop "$SERVICE"
    echo "CLI bot stopped."
    "$PYTHON" "$BOT" --status 2>/dev/null || true
}

cmd_restart() {
    stop_all_lanes
    systemctl --user restart "$SERVICE"
    sleep 1
    sync_lanes "$(lane_count)"
    echo "CLI bot restarted."
    "$PYTHON" "$BOT" --status 2>/dev/null || true
}

cmd_status() {
    echo ""
    echo "── CLI Bot Service ──"
    systemctl --user status "$SERVICE" --no-pager 2>/dev/null || echo "  Not running"
    echo ""
    echo "── Session Status ──"
    "$PYTHON" "$BOT" --status 2>/dev/null || echo "  No active session"
    if [ "$(lane_count)" -gt 1 ]; then
        echo ""
        "$PYTHON" "$BOT" --lanes-status 2>/dev/null || true
    fi
}

cmd_logs() {
    journalctl --user -u "$SERVICE" -f --no-pager
}

cmd_logs_full() {
    journalctl --user -u "$SERVICE" -n 200 --no-pager
}

cmd_monitor() {
    local k="${1:-1}"
    case "$k" in ''|*[!0-9]*) k=1 ;; esac
    "$PYTHON" "$BOT" --monitor --lane "$k"
}

cmd_interactive() {
    if [ ! -f "$HOME/.wolfbet_autobot.json" ]; then
        echo "No config found. Run 'wolfctl setup' first."
        exit 1
    fi
    if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        systemctl --user start "$SERVICE"
        sleep 1
        if ! systemctl --user is-active --quiet "$SERVICE"; then
            echo "Failed to start daemon. Check: wolfctl logs-full"
            exit 1
        fi
        echo "Daemon started."
    fi
    "$PYTHON" "$BOT" --monitor
}

cmd_tmux() {
    SESSION="wolfbet"
    if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        if [ ! -f "$HOME/.wolfbet_autobot.json" ]; then
            echo "No config found. Run 'wolfctl setup' first."
            exit 1
        fi
        systemctl --user start "$SERVICE"
        sleep 1
    fi
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "tmux session '$SESSION' already running."
        echo "  Attach:  tmux attach -t $SESSION"
    else
        tmux new-session -d -s "$SESSION" "$PYTHON $BOT --monitor"
        echo "Started monitor in tmux session '$SESSION'"
        echo "  Attach:  tmux attach -t $SESSION"
        echo "  Detach:  Ctrl+B then D"
    fi
}

cmd_stats() {
