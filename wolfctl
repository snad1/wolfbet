# v3.9 — hard statistics reset. ARCHIVES the DB (mv, never deletes) so a
# fresh statistics flow can begin while config stays untouched. The daemon
# is stopped if running; stale live-state is cleared so --resume doesn't
# resurrect the old session number into the fresh DB.
cmd_reset() {
    local yes=0
    for arg in "$@"; do
        case "$arg" in
            --yes|-y) yes=1 ;;
        esac
    done
    local db="$HOME/.wolfbet_autobot.db"
    if [ ! -f "$db" ]; then
        echo "No DB found at $db — nothing to reset."
        return
    fi
    local sess bets size
    sess=$(sqlite3 "$db" "SELECT COUNT(*) FROM sessions" 2>/dev/null || echo "?")
    bets=$(sqlite3 "$db" "SELECT COALESCE(SUM(total_bets),0) FROM sessions" 2>/dev/null || echo "?")
    size=$(du -h "$db" | awk '{print $1}')
    local was_running=0
    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        was_running=1
    fi
    if [ "$yes" = "0" ]; then
        echo "This will ARCHIVE (not delete) your statistics and start fresh:"
        echo "  sessions: $sess   bets: $bets   db size: $size"
        echo "  archive  → ~/.wolfbet_autobot-<timestamp>.db"
        echo "  config   → untouched (~/.wolfbet_autobot.json)"
        [ "$was_running" = "1" ] && echo "  daemon   → will be stopped (not restarted)"
        read -r -p "Proceed? [y/N] " reply
        case "$reply" in
            y|Y|yes|YES) ;;
            *) echo "Aborted."; return ;;
        esac
    fi
    if [ "$was_running" = "1" ]; then
        stop_all_lanes
        systemctl --user stop "$SERVICE"
        echo "Daemon stopped."
    fi
    local ts archive
    ts=$(date +%Y%m%d-%H%M%S)
    archive="$HOME/.wolfbet_autobot-$ts.db"
    mv "$db" "$archive"
    # Stale live-state would make --resume point at the old session number.
    rm -f "$HOME/.wolfbet_autobot_live.json" "$HOME"/.wolfbet_autobot_live.lane*.json
    echo "Archived → $archive  ($sess sessions, $bets bets, $size)"
    echo "Config untouched. Next 'wolfctl start' begins fresh statistics."
    echo "Revisit anytime: wolfctl archives"
}

# v3.9 — list archived statistics DBs with session counts + date spans.
cmd_archives() {
    local found=0 total_bytes=0
    for f in "$HOME"/.wolfbet_autobot-*.db; do
        [ -f "$f" ] || continue
        found=1
        local sess span size bytes
        sess=$(sqlite3 "$f" "SELECT COUNT(*) FROM sessions" 2>/dev/null || echo "?")
        span=$(sqlite3 "$f" "SELECT COALESCE(MIN(started_at),'?') || ' → ' || COALESCE(MAX(started_at),'?')" 2>/dev/null || echo "?")
        size=$(du -h "$f" | awk '{print $1}')
        bytes=$(du -b "$f" | awk '{print $1}')
        total_bytes=$(( total_bytes + bytes ))
        printf "  %s  %s sessions  %s  %s\n" "$(basename "$f")" "$sess" "$span" "$size"
    done
    if [ "$found" = "0" ]; then
        echo "No archives found (~/.wolfbet_autobot-*.db)."
        echo "Create one with: wolfctl reset"
        return
    fi
    echo ""
    echo "  Total: $(echo "$total_bytes" | awk '{printf "%.1f MB", $1/1024/1024}')"
    echo "  Query any archive directly: sqlite3 <archive> 'SELECT … FROM sessions'"
}

# v2.26.1 — BPS diagnostics.
cmd_benchmark() {
    # wolfctl benchmark [N] [--lanes M]
    local n="" args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --lanes) args+=(--lanes "${2:-2}"); shift 2 || shift ;;
            *[!0-9]*|'') shift ;;
            *) n="$1"; shift ;;
        esac
    done
    if [ -z "$n" ]; then
        "$PYTHON" "$BOT" --benchmark ${args[@]+"${args[@]}"}
    else
        "$PYTHON" "$BOT" --benchmark "$n" ${args[@]+"${args[@]}"}
    fi
}

cmd_diagnose() {
    "$PYTHON" "$BOT" --diagnose
}

# v3.9 — health check + prescriptive advice for reducing per-bet overhead.
# Read-only by default. `--fix` applies the three safe cleanups
# (cleanup + VACUUM + journal vacuum); privileged fixes (renice / ionice /
# cpupower) are prescribed only, never auto-applied. On virtualized hosts
# (QEMU-KVM VPS) the governor prescription is downgraded to [SKIP] because
# guests can't influence host CPU governor from inside.
cmd_doctor() {
    local do_fix=0 do_yes=0
    for arg in "$@"; do
        case "$arg" in
            --fix)     do_fix=1 ;;
            --yes|-y)  do_yes=1 ;;
        esac
    done

    echo "─── wolfctl doctor ───"
    echo ""
    echo "1. Live diagnostic (wolfctl diagnose):"
    "$PYTHON" "$BOT" --diagnose 2>/dev/null || echo "  (daemon not running — start with 'wolfctl start')"

    echo ""
    echo "2. Database health:"
    local db_size page_count freelist frag_pct
    frag_pct=0
    if [ -f "$HOME/.wolfbet_autobot.db" ]; then
        local db="$HOME/.wolfbet_autobot.db"
        db_size=$(du -h "$db" 2>/dev/null | awk '{print $1}')
        page_count=$(sqlite3 "$db" "PRAGMA page_count" 2>/dev/null || echo 0)
        freelist=$(sqlite3 "$db" "PRAGMA freelist_count" 2>/dev/null || echo 0)
        if [ "$page_count" -gt 0 ] 2>/dev/null; then
            frag_pct=$(( freelist * 100 / page_count ))
        fi
        echo "  DB: $db  size=$db_size  fragmentation=${frag_pct}% (freelist=$freelist / pages=$page_count)"
    else
        echo "  DB: $HOME/.wolfbet_autobot.db not found (daemon has never run?)"
    fi

    echo ""
    echo "3. Journal size (wolfbet.service):"
    journalctl --user -u "$SERVICE" --disk-usage 2>/dev/null | sed 's/^/  /' \
        || echo "  (not managed by systemd)"

    echo ""
    echo "4. System resources:"
    echo "  Load: $(uptime | awk -F'load average: ' '{print $2}')"
    echo "  Memory:"
    free -h | sed 's/^/    /'
    echo "  Disk on \$HOME:"
    df -h "$HOME" | tail -1 | sed 's/^/    /'
    echo "  CPU governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)"

    echo ""
    echo "5. Daemon priority:"
    local pid nice_val ionice_val
    pid=$(pgrep -f 'wolfbet\.py.*--daemon' | head -1)
    if [ -n "$pid" ]; then
        nice_val=$(ps -o ni= -p "$pid" 2>/dev/null | tr -d ' ')
        ionice_val=$(ionice -p "$pid" 2>/dev/null || echo "unknown")
        echo "  PID $pid  nice=${nice_val:-?}  ${ionice_val}"
    else
        echo "  (daemon not running)"
    fi

    echo ""
    echo "─── Prescriptions ───"

    local do_vacuum=0 do_journal=0
    if [ "$frag_pct" -ge 20 ] 2>/dev/null; then
        echo "  [SAFE]  SQLite VACUUM (fragmentation ${frag_pct}% ≥ 20%):"
        echo "          sqlite3 \$HOME/.wolfbet_autobot.db 'VACUUM;'"
        do_vacuum=1
    fi
    echo "  [SAFE]  Force bet-row retention now:"
    echo "          wolfctl cleanup 1"

    local jsz
    jsz=$(journalctl --user -u "$SERVICE" --disk-usage 2>/dev/null \
          | grep -oE '[0-9.]+[KMG]' | head -1)
    if [ -n "$jsz" ] && echo "$jsz" | grep -qE '[0-9]+G|[5-9][0-9][0-9]M'; then
        echo "  [SAFE]  Journal is large ($jsz) — vacuum to 100 M:"
        echo "          journalctl --user --vacuum-size=100M"
        do_journal=1
    fi

    if [ -n "$pid" ] && [ -n "$nice_val" ] && [ "$nice_val" -gt -5 ] 2>/dev/null; then
        echo "  [PRIV]  Raise daemon scheduling priority (needs sudo):"
        echo "          sudo renice -n -5 -p $pid"
        echo "          sudo ionice -c 2 -n 0 -p $pid"
    fi

    # v3.9 — governor prescription only if the host actually allows it.
    # QEMU-KVM guests (most VPS) can't change the governor from inside;
    # cpupower returns "Error setting new values" and confuses the operator.
    local virt=""
    if command -v systemd-detect-virt >/dev/null 2>&1; then
        virt=$(systemd-detect-virt 2>/dev/null || echo "")
    fi
    local gov
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
    if [ -n "$gov" ] && [ "$gov" != "performance" ]; then
        if [ -n "$virt" ] && [ "$virt" != "none" ]; then
            echo "  [SKIP]  CPU governor is '$gov' (not performance) but this host"
            echo "          is virtualized ($virt) — guests cannot set the governor."
            echo "          Ask your VPS provider or migrate to a dedicated-CPU plan."
        else
            echo "  [PRIV]  Pin CPU governor to performance (needs sudo):"
            echo "          sudo cpupower frequency-set -g performance"
        fi
    elif [ -z "$gov" ] && [ -n "$virt" ] && [ "$virt" != "none" ]; then
        # v3.9 — governor path unreadable AND host is virtualized: still
        # surface the honest "your VPS can't do this" advice instead of
        # staying silent (which hid the reason from operators hitting the
        # cpupower failure in the earlier runbook).
        echo "  [SKIP]  CPU governor path not exposed on this virtualized host ($virt)."
        echo "          VPS provider controls it — migrate to a dedicated-CPU plan if needed."
    fi

    if [ "$do_fix" = "1" ]; then
        echo ""
        echo "─── Applying safe fixes (--fix) ───"
        _doctor_run_fix() {
            local desc="$1" cmd="$2"
            if [ "$do_yes" = "0" ]; then
                read -r -p "  $desc — apply? [y/N] " reply
                case "$reply" in
                    y|Y|yes|YES) ;;
                    *) echo "    skipped." ; return ;;
                esac
            fi
            echo "  \$ $cmd"
            eval "$cmd"
        }
        _doctor_run_fix "Force bet-row retention (age > 1 day)" \
                        "\"$PYTHON\" \"$BOT\" --cleanup 1"
        if [ "$do_vacuum" = "1" ]; then
            _doctor_run_fix "SQLite VACUUM (reclaim fragmented pages)" \
                            "sqlite3 \"$HOME/.wolfbet_autobot.db\" 'VACUUM;'"
        fi
        if [ "$do_journal" = "1" ]; then
            _doctor_run_fix "Journal vacuum to 100 M" \
                            "journalctl --user --vacuum-size=100M"
        fi
        echo ""
        echo "Done. Run 'wolfctl diagnose' again in 5 minutes to see the delta."
    else
        echo ""
        echo "To apply the [SAFE] fixes automatically, run: wolfctl doctor --fix"
        echo "Add --yes to skip per-fix confirmation."
    fi
}

cmd_update() {
    # Pull latest from git if inside a repo
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Pulling latest from git…"
        # Detect a dirty tracked-file tree so the user sees WHAT got autostashed.
        if ! git diff --quiet || ! git diff --cached --quiet; then
            echo "Local changes detected — autostashing before pull:"
            git status --porcelain
        fi
        # --autostash (git ≥ 2.9) stashes local changes, pulls, then pops.
        # Pop-conflicts leave the stash in place for manual recovery.
        if ! git pull --ff-only --autostash; then
            echo "Git pull failed. Resolve manually."
            echo "  If you had local changes, they were stashed."
            echo "  Recover with: git stash list  |  git stash pop"
            exit 1
        fi
    fi
    echo "Updating bot files…"
    if [ ! -f "wolfbet.py" ]; then
        echo "No wolfbet.py in current directory."
        exit 1
    fi

    cp wolfbet.py         "$INSTALL_DIR/wolfbet.py"
    cp requirements.txt   "$INSTALL_DIR/requirements.txt"

    # Update core/
    if [ -d "core" ]; then
        mkdir -p "$INSTALL_DIR/core"
        cp core/*.py "$INSTALL_DIR/core/"
    fi

    # Update tg/
    if [ -d "tg" ]; then
        mkdir -p "$INSTALL_DIR/tg"
        cp tg/*.py "$INSTALL_DIR/tg/"
    fi

    # Update shared/ library
    if [ -d "../shared" ]; then
        rm -rf "$INSTALL_DIR/shared"
        cp -r ../shared "$INSTALL_DIR/"
        echo "shared/ library updated."
    fi

    # Update casino-shared pip package
    if [ -f "$INSTALL_DIR/venv/bin/pip" ]; then
        "$INSTALL_DIR/venv/bin/pip" install --force-reinstall --no-cache-dir --quiet \
            "casino-shared @ git+https://github.com/snad1/casino-shared.git" 2>/dev/null && \
            echo "casino-shared pip package updated." || \
            echo "casino-shared pip update skipped (network issue)."
    fi

    # Self-update: copy this script to its installed location
    if [ -f "$SCRIPT_NAME" ]; then
        local installed repo_ver
        installed="$(command -v "$SCRIPT_NAME" 2>/dev/null || true)"
        if [ -n "$installed" ] && [ -f "$installed" ]; then
            cp "$SCRIPT_NAME" "$installed"
            chmod +x "$installed"
            echo "Updated $SCRIPT_NAME → $installed"
        fi
        # v3.9 — surface drift when the currently-executing wolfctl is older
        # than the repo copy. Chicken-and-egg: the OLD installed wolfctl won't
        # run this block at all, so on the FIRST upgrade the operator must
        # rerun `wolfctl update` (or `exec wolfctl update`) once to pick up
        # the new dispatcher. Subsequent runs self-heal.
        repo_ver="$(grep -m1 '^WOLFCTL_VERSION=' "$SCRIPT_NAME" 2>/dev/null | cut -d= -f2)"
        if [ -n "$repo_ver" ] && [ "$repo_ver" != "${WOLFCTL_VERSION:-unknown}" ]; then
            echo ""
            echo "  ⚠  wolfctl was stale: ${WOLFCTL_VERSION:-unknown} → $repo_ver"
            echo "     Re-run once to activate the new dispatcher:"
            echo "       exec wolfctl update"
            echo ""
        fi
    fi

    # v2.28.1 — migrate old Restart=always → Restart=on-failure so that
    # `wolfctl stop` and monitor's [S] stay stopped instead of triggering a
    # systemd respawn. Idempotent: subsequent runs find no match and skip.
    local _sd_reload=0
    for _unit in wolfbet.service wolfbet-tg.service wolfbet-web.service; do
        local _unit_path="$HOME/.config/systemd/user/$_unit"
        [ -f "$_unit_path" ] || continue
        if grep -q '^Restart=always$' "$_unit_path"; then
            sed -i.bak 's/^Restart=always$/Restart=on-failure/' "$_unit_path" \
                && rm -f "$_unit_path.bak" \
                && echo "Migrated $_unit: Restart=always → Restart=on-failure" \
                && _sd_reload=1
        fi
        # v3.9 — persist Nice=-5 + best-effort IO priority in the unit so the
        # daemon starts with elevated scheduling on every restart. Was a
        # per-PID renice/ionice the operator had to reapply after every
        # `wolfctl update` (which restarts the CLI as of v2.30.2). Idempotent:
        # subsequent runs find Nice= already present and skip.
        if [ "$_unit" = "wolfbet.service" ] && ! grep -q '^Nice=' "$_unit_path"; then
            sed -i.bak '/^\[Service\]$/a Nice=-5\nIOSchedulingClass=best-effort\nIOSchedulingPriority=0' "$_unit_path" \
                && rm -f "$_unit_path.bak" \
                && echo "Added Nice=-5 + IO priority to $_unit" \
                && _sd_reload=1
        fi
    done
    if [ "$_sd_reload" = "1" ]; then
        systemctl --user daemon-reload 2>/dev/null || true
    fi

    # Re-install deps
    "$INSTALL_DIR/venv/bin/pip" install --quiet -r "$INSTALL_DIR/requirements.txt"

    # Update web app if installed
    if [ -d "$WEB_DIR" ] && [ -d "web" ]; then
        mkdir -p "$WEB_DIR/web"
        cp -r web/* "$WEB_DIR/web/" 2>/dev/null || true
        [ -f "web/requirements.txt" ] && cp web/requirements.txt "$WEB_DIR/requirements.txt"
        "$WEB_DIR/venv/bin/pip" install --quiet -r "$WEB_DIR/requirements.txt" 2>/dev/null || true
        if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
            systemctl --user restart "$WEB_SERVICE"
            echo "Web admin updated + restarted."
        fi
    fi

    # Auto-restart TG bot if running
    if systemctl --user is-active --quiet "$TG_SERVICE" 2>/dev/null; then
        systemctl --user restart "$TG_SERVICE"
        sleep 1
        if systemctl --user is-active --quiet "$TG_SERVICE"; then
            echo "Updated + Telegram bot restarted."
        else
            echo "Updated but TG restart failed. Check: wolfctl tg logs"
        fi
    else
        echo "Updated. TG bot not running (skipped restart)."
    fi

    # v3.9 — auto-restart CLI daemon so the running process picks up the new
    # wolfbet.py. Before this, `wolfctl update` only refreshed the file on
    # disk and left the daemon on the pre-pull code until manual restart.
    # --resume preserves session state across the restart.
    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        stop_all_lanes
        systemctl --user restart "$SERVICE"
        sleep 1
        # v3.10 — bring parallel lanes back on the new code too.
        sync_lanes "$(lane_count)"
        if systemctl --user is-active --quiet "$SERVICE"; then
            echo "CLI daemon restarted (session auto-resumed)."
        else
            echo "CLI restart failed. Check: wolfctl logs"
        fi
    else
        echo "  CLI bot: wolfctl restart"
    fi
}

# ── Telegram bot commands ────────────────────────────
cmd_tg() {
    local action="${1:-status}"
    case "$action" in
        start)
            if [ -f "$ENV_FILE" ]; then
                TOKEN=$(grep -E "^WOLFBET_TG_TOKEN=" "$ENV_FILE" | cut -d= -f2- | tr -d ' ')
                if [ -z "$TOKEN" ]; then
                    echo "Telegram token not set. Edit: wolfctl tg env"
                    exit 1
                fi
            else
                echo "No .env file found. Run installer or create: $ENV_FILE"
                exit 1
            fi
            systemctl --user start "$TG_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$TG_SERVICE"; then
                echo "Telegram bot started."
                echo "  Logs: wolfctl tg logs"
            else
                echo "Failed to start. Check: wolfctl tg logs"
                systemctl --user status "$TG_SERVICE" --no-pager 2>/dev/null || true
                exit 1
            fi
            ;;
        stop)
            systemctl --user stop "$TG_SERVICE"
            echo "Telegram bot stopped."
            ;;
        restart)
            systemctl --user restart "$TG_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$TG_SERVICE"; then
                echo "Telegram bot restarted."
            else
                echo "Failed to restart. Check: wolfctl tg logs"
                exit 1
            fi
            ;;
        status)
            echo ""
            echo "── Telegram Bot Service ──"
            systemctl --user status "$TG_SERVICE" --no-pager 2>/dev/null || echo "  Not running"
            echo ""
            if [ -f "$ENV_FILE" ]; then
                TOKEN=$(grep -E "^WOLFBET_TG_TOKEN=" "$ENV_FILE" | cut -d= -f2- | tr -d ' ')
                if [ -n "$TOKEN" ]; then
                    echo "  Token: ${TOKEN:0:10}…(set)"
                else
                    echo "  Token: NOT SET — run: wolfctl tg env"
                fi
            else
                echo "  .env: NOT FOUND"
            fi
            ;;
        logs)
            journalctl --user -u "$TG_SERVICE" -f --no-pager
            ;;
        logs-full)
            journalctl --user -u "$TG_SERVICE" -n 200 --no-pager
            ;;
        env)
            if [ ! -f "$ENV_FILE" ]; then
                cat > "$ENV_FILE" << 'INNEREOF'
# WolfBet AutoBot — Environment
WOLFBET_TG_TOKEN=
WOLFBET_TG_DATA=~/.wolfbot_tg
INNEREOF
            fi
            "${EDITOR:-nano}" "$ENV_FILE"
            echo "Restart Telegram bot to apply: wolfctl tg restart"
            ;;
        *)
            echo "Usage: wolfctl tg [start|stop|restart|status|logs|logs-full|env]"
            ;;
    esac
}

# ── All-services commands ────────────────────────────
cmd_start_all() {
    echo "Starting all services…"
    cmd_start 2>/dev/null || true
    cmd_tg start 2>/dev/null || true
    echo ""
    cmd_status_all
}

cmd_stop_all() {
    echo "Stopping all services…"
    systemctl --user stop "$SERVICE" 2>/dev/null || true
    systemctl --user stop "$TG_SERVICE" 2>/dev/null || true
    echo "All services stopped."
}

cmd_status_all() {
    echo ""
    echo "╔══════════════════════════════════════════╗"
    echo "║   WolfBet AutoBot — Service Status        ║"
    echo "╚══════════════════════════════════════════╝"
    echo ""

    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        echo "  CLI Bot:      ● RUNNING"
    else
        echo "  CLI Bot:      ○ stopped"
    fi

    if systemctl --user is-active --quiet "$TG_SERVICE" 2>/dev/null; then
        echo "  Telegram Bot: ● RUNNING"
    else
        echo "  Telegram Bot: ○ stopped"
    fi

    if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
        echo "  Web Admin:    ● RUNNING"
    else
        echo "  Web Admin:    ○ stopped"
    fi

    echo ""
}

cmd_web() {
    local action="${1:-status}"
    case "$action" in
        install)
            if [ -f "web/install.sh" ]; then
                bash web/install.sh --repo "$(pwd)" "${@:2}"
            else
                echo "web/install.sh not found. Run from the repo directory."
                exit 1
            fi
            ;;
        start)
            systemctl --user start "$WEB_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$WEB_SERVICE"; then
                echo "Web admin started."
            else
                echo "Failed to start. Check: wolfctl web logs"
                exit 1
            fi
            ;;
        stop)
            systemctl --user stop "$WEB_SERVICE"
            echo "Web admin stopped."
            ;;
        restart)
            systemctl --user restart "$WEB_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$WEB_SERVICE"; then
                echo "Web admin restarted."
            else
                echo "Failed to restart. Check: wolfctl web logs"
                exit 1
            fi
            ;;
        status)
            echo ""
            echo "── Web Admin Status ──"
            systemctl --user status "$WEB_SERVICE" --no-pager 2>/dev/null || echo "  Service not running"
            ;;
        logs)
            journalctl --user -u "$WEB_SERVICE" -f --no-pager
            ;;
        logs-full)
            journalctl --user -u "$WEB_SERVICE" -n 200 --no-pager
            ;;
        update)
            if [ -d "web" ]; then
                echo "Updating web app files…"
                mkdir -p "$WEB_DIR/web"
                cp -r web/* "$WEB_DIR/web/" 2>/dev/null || true
                [ -f "web/requirements.txt" ] && cp web/requirements.txt "$WEB_DIR/requirements.txt"
                [ -f "$WEB_DIR/.env" ] || cp "$WEB_DIR/.env.example" "$WEB_DIR/.env" 2>/dev/null || true
                "$WEB_DIR/venv/bin/pip" install --quiet -r "$WEB_DIR/requirements.txt" 2>/dev/null || true
                if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
                    systemctl --user restart "$WEB_SERVICE"
                    sleep 1
                    echo "Web admin updated + restarted."
                else
                    echo "Web admin updated. Start with: wolfctl web start"
                fi
            else
                echo "No web/ directory found."
                exit 1
            fi
            ;;
        *)
            echo "Usage: wolfctl web [install|start|stop|restart|status|logs|logs-full|update]"
            ;;
    esac
}

# ── Dispatch ─────────────────────────────────────────
case "${1:-}" in
    setup)        cmd_setup ;;
    start)        cmd_start ;;
    stop)         cmd_stop ;;
    restart)      cmd_restart ;;
    status)       cmd_status ;;
    monitor)      cmd_monitor "${2:-}" ;;
    lanes)        shift; cmd_lanes "$@" ;;
    logs)         cmd_logs ;;
    logs-full)    cmd_logs_full ;;
    interactive)  cmd_interactive ;;
    tmux)         cmd_tmux ;;
    stats)        shift; cmd_stats "$@" ;;
    reset)        shift; cmd_reset "$@" ;;
    archives)     cmd_archives ;;
    session)      cmd_session "${2:-}" ;;
    presets)      cmd_presets ;;
    analytics)    shift; cmd_analytics "$@" ;;
    last-bets)    cmd_last_bets "${2:-}" ;;
    export)       cmd_export "${2:-}" "${3:-}" ;;
    config-show)  cmd_config_show ;;
    config-set)   shift; cmd_config_set "$@" ;;
    pipeline)     cmd_pipeline "${2:-}" ;;
    backtest)     shift; cmd_backtest "$@" ;;
    preset)       cmd_preset "${2:-}" ;;
    cleanup)      cmd_cleanup "${2:-}" ;;
    benchmark)    shift; cmd_benchmark "$@" ;;
    diagnose)     cmd_diagnose ;;
    doctor)       shift; cmd_doctor "$@" ;;
    version|--version|-v) cmd_version ;;
    update)       cmd_update ;;
    tg)           cmd_tg "${2:-}" ;;
    web)          cmd_web "${@:2}" ;;
    start-all)    cmd_start_all ;;
    stop-all)     cmd_stop_all ;;
    status-all)   cmd_status_all ;;
    help|--help|-h) usage ;;
    *)            usage ;;
esac
exit
}
