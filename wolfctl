#!/usr/bin/env bash
# WolfBet AutoBot — Unified Management Command v3.6
# Wrapped in { } so bash reads entire script before executing —
# prevents corruption when cmd_update replaces this file mid-run.
{
set -euo pipefail

INSTALL_DIR="$HOME/wolfbet-bot"
WEB_DIR="$HOME/wolfbet-web"
SERVICE="wolfbet"
TG_SERVICE="wolfbet-tg"
WEB_SERVICE="wolfbet-web"
PYTHON="$INSTALL_DIR/venv/bin/python3"
BOT="$INSTALL_DIR/wolfbet.py"
ENV_FILE="$INSTALL_DIR/.env"
SCRIPT_NAME="wolfctl"
# v3.6 — surface installed-vs-repo drift so operators stuck on an old
# wolfctl (from before the self-copy block landed) see a warning instead
# of a silent "already up to date". This constant is grep-parsed by
# cmd_update's drift check — keep the format `WOLFCTL_VERSION=X.Y`.
WOLFCTL_VERSION=3.6

usage() {
    echo ""
    echo "  wolfctl — WolfBet AutoBot Manager v3.6"
    echo ""
    echo "  CLI BOT:"
    echo "    wolfctl setup         Run wizard to configure"
    echo "    wolfctl start         Start CLI bot as daemon"
    echo "    wolfctl stop          Stop CLI bot"
    echo "    wolfctl restart       Restart CLI bot"
    echo "    wolfctl status        Show CLI bot status"
    echo "    wolfctl monitor       Attach live TUI to running daemon"
    echo "    wolfctl logs          Stream CLI bot logs"
    echo "    wolfctl logs-full     Show last 200 log lines"
    echo ""
    echo "  TELEGRAM BOT:"
    echo "    wolfctl tg start      Start Telegram bot"
    echo "    wolfctl tg stop       Stop Telegram bot"
    echo "    wolfctl tg restart    Restart Telegram bot"
    echo "    wolfctl tg status     Show Telegram bot status"
    echo "    wolfctl tg logs       Stream Telegram bot logs"
    echo "    wolfctl tg env        Edit .env file (token, config)"
    echo ""
    echo "  ALL SERVICES:"
    echo "    wolfctl start-all     Start both CLI + Telegram bots"
    echo "    wolfctl stop-all      Stop both bots"
    echo "    wolfctl status-all    Show status of all services"
    echo ""
    echo "  SHORTCUTS:"
    echo "    wolfctl interactive   Start CLI daemon + attach monitor"
    echo "    wolfctl tmux          Monitor in detachable tmux session"
    echo ""
    echo "  CONFIG:"
    echo "    wolfctl config-show                    Show current config (API key masked)"
    echo "    wolfctl config-set KEY=VALUE [K=V …]   Non-interactive tweak (delay=0.35, maxprofit=0.005, …)"
    echo "    wolfctl pipeline N                     Set pipeline depth (1..8; Flat-only)"
    echo ""
    echo "  DATA:"
    echo "    wolfctl stats               Recent 20 sessions in detail"
    echo "    wolfctl analytics           Lifetime aggregates + top 5 best/worst"
    echo "    wolfctl session ID          Full stats + streaks for one session"
    echo "    wolfctl last-bets N         Last N bets across all sessions (default 20)"
    echo "    wolfctl presets             List saved presets"
    echo "    wolfctl export PATH [SID]   Export sessions (CSV/JSON by extension)"
    echo "    wolfctl cleanup [DAYS]      Purge old bet rows (default: state.purge_days)"
    echo ""
    echo "  TOOLS:"
    echo "    wolfctl benchmark [N]       API-latency probe (no bets placed; default N=20)"
    echo "    wolfctl diagnose            Analyse running session bottleneck (top blocker + advice)"
    echo "    wolfctl backtest [args…]    Backtest / replay (no API calls, no real balance)"
    echo "                                Examples: --simulate 10000 --seed 42"
    echo "                                          --replay-session 42 --preset foo"
    echo "    wolfctl preset NAME         Load preset + start daemon"
    echo "    wolfctl update              Pull latest + reinstall (git repo required)"
    echo "    wolfctl version             Show CLI + wolfctl versions"
    echo ""
    echo "  WEB ADMIN:"
    echo "    wolfctl web install         Install web admin dashboard"
    echo "    wolfctl web start           Start web app"
    echo "    wolfctl web stop            Stop web app"
    echo "    wolfctl web restart         Restart web app"
    echo "    wolfctl web status          Show web app status"
    echo "    wolfctl web logs            Stream web app logs"
    echo "    wolfctl web update          Update web app files"
    echo ""
}

# ── CLI bot commands ──────────────────────────────────
cmd_setup() {
    echo "Running setup wizard…"
    "$PYTHON" "$BOT" --setup-only
}

cmd_start() {
    if [ ! -f "$HOME/.wolfbet_autobot.json" ]; then
        echo "No config found. Run 'wolfctl setup' first."
        exit 1
    fi
    systemctl --user start "$SERVICE"
    sleep 1
    if systemctl --user is-active --quiet "$SERVICE"; then
        echo "CLI bot started."
        echo "  Check: wolfctl status"
        echo "  Logs:  wolfctl logs"
    else
        echo "Failed to start. Check: wolfctl logs-full"
        exit 1
    fi
}

cmd_stop() {
    systemctl --user stop "$SERVICE"
    echo "CLI bot stopped."
    "$PYTHON" "$BOT" --status 2>/dev/null || true
}

cmd_restart() {
    systemctl --user restart "$SERVICE"
    sleep 1
    echo "CLI bot restarted."
    "$PYTHON" "$BOT" --status 2>/dev/null || true
}

cmd_status() {
    echo ""
    echo "── CLI Bot Service ──"
    systemctl --user status "$SERVICE" --no-pager 2>/dev/null || echo "  Not running"
    echo ""
    echo "── Session Status ──"
    "$PYTHON" "$BOT" --status 2>/dev/null || echo "  No active session"
}

cmd_logs() {
    journalctl --user -u "$SERVICE" -f --no-pager
}

cmd_logs_full() {
    journalctl --user -u "$SERVICE" -n 200 --no-pager
}

cmd_monitor() {
    "$PYTHON" "$BOT" --monitor
}

cmd_interactive() {
    if [ ! -f "$HOME/.wolfbet_autobot.json" ]; then
        echo "No config found. Run 'wolfctl setup' first."
        exit 1
    fi
    if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        systemctl --user start "$SERVICE"
        sleep 1
        if ! systemctl --user is-active --quiet "$SERVICE"; then
            echo "Failed to start daemon. Check: wolfctl logs-full"
            exit 1
        fi
        echo "Daemon started."
    fi
    "$PYTHON" "$BOT" --monitor
}

cmd_tmux() {
    SESSION="wolfbet"
    if ! systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        if [ ! -f "$HOME/.wolfbet_autobot.json" ]; then
            echo "No config found. Run 'wolfctl setup' first."
            exit 1
        fi
        systemctl --user start "$SERVICE"
        sleep 1
    fi
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "tmux session '$SESSION' already running."
        echo "  Attach:  tmux attach -t $SESSION"
    else
        tmux new-session -d -s "$SESSION" "$PYTHON $BOT --monitor"
        echo "Started monitor in tmux session '$SESSION'"
        echo "  Attach:  tmux attach -t $SESSION"
        echo "  Detach:  Ctrl+B then D"
    fi
}

cmd_stats() {
    "$PYTHON" "$BOT" --stats
}

cmd_session() {
    local sid="${1:-}"
    if [ -z "$sid" ]; then
        echo "Usage: wolfctl session <ID>"
        exit 1
    fi
    "$PYTHON" "$BOT" --session-bets "$sid"
}

cmd_presets() {
    "$PYTHON" "$BOT" --list-presets
}

# ── v2.25.0 parity — read-only inspection ─────────────
cmd_analytics() {
    "$PYTHON" "$BOT" --analytics
}

cmd_last_bets() {
    local n="${1:-20}"
    "$PYTHON" "$BOT" --last-bets "$n"
}

cmd_config_show() {
    "$PYTHON" "$BOT" --config-show
}

cmd_version() {
    "$PYTHON" "$BOT" --version
    echo "  wolfctl v3.6"
}

# ── v2.25.0 parity — mutation ──────────────────────────
cmd_config_set() {
    if [ $# -eq 0 ]; then
        echo "Usage: wolfctl config-set KEY=VALUE [KEY=VALUE …]"
        echo "  Aliases match the T-hotkey grammar (delay, maxprofit, pipeline, …)."
        echo "  api_key is refused — set WOLFBET_API_KEY env var instead."
        exit 2
    fi
    "$PYTHON" "$BOT" --config-set "$@"
}

cmd_pipeline() {
    local n="${1:-}"
    if [ -z "$n" ]; then
        echo "Usage: wolfctl pipeline N   (N = 1..8; Flat-only, 1 disables)"
        exit 2
    fi
    "$PYTHON" "$BOT" --config-set "pipeline_depth=$n"
}

# ── v2.25.0 parity — data + tools ──────────────────────
cmd_export() {
    local path="${1:-}"
    local sid="${2:-}"
    if [ -z "$path" ]; then
        echo "Usage: wolfctl export PATH [SESSION_ID]"
        echo "  Format inferred from .csv / .json extension."
        exit 2
    fi
    if [ -n "$sid" ]; then
        "$PYTHON" "$BOT" --export "$path" --export-session-id "$sid"
    else
        "$PYTHON" "$BOT" --export "$path"
    fi
}

cmd_backtest() {
    "$PYTHON" "$BOT" --backtest "$@"
}

cmd_preset() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "Usage: wolfctl preset NAME"
        echo "  Loads named preset and starts as a daemon. Attach with: wolfctl monitor"
        exit 2
    fi
    "$PYTHON" "$BOT" --preset "$name" --daemon
}

# v2.26.0 — bet-row retention purge (delegates to CLI's --cleanup).
cmd_cleanup() {
    local days="${1:-}"
    if [ -z "$days" ]; then
        "$PYTHON" "$BOT" --cleanup
    else
        "$PYTHON" "$BOT" --cleanup "$days"
    fi
}

# v2.26.1 — BPS diagnostics.
cmd_benchmark() {
    local n="${1:-}"
    if [ -z "$n" ]; then
        "$PYTHON" "$BOT" --benchmark
    else
        "$PYTHON" "$BOT" --benchmark "$n"
    fi
}

cmd_diagnose() {
    "$PYTHON" "$BOT" --diagnose
}

cmd_update() {
    # Pull latest from git if inside a repo
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Pulling latest from git…"
        # Detect a dirty tracked-file tree so the user sees WHAT got autostashed.
        if ! git diff --quiet || ! git diff --cached --quiet; then
            echo "Local changes detected — autostashing before pull:"
            git status --porcelain
        fi
        # --autostash (git ≥ 2.9) stashes local changes, pulls, then pops.
        # Pop-conflicts leave the stash in place for manual recovery.
        if ! git pull --ff-only --autostash; then
            echo "Git pull failed. Resolve manually."
            echo "  If you had local changes, they were stashed."
            echo "  Recover with: git stash list  |  git stash pop"
            exit 1
        fi
    fi
    echo "Updating bot files…"
    if [ ! -f "wolfbet.py" ]; then
        echo "No wolfbet.py in current directory."
        exit 1
    fi

    cp wolfbet.py         "$INSTALL_DIR/wolfbet.py"
    cp requirements.txt   "$INSTALL_DIR/requirements.txt"

    # Update core/
    if [ -d "core" ]; then
        mkdir -p "$INSTALL_DIR/core"
        cp core/*.py "$INSTALL_DIR/core/"
    fi

    # Update tg/
    if [ -d "tg" ]; then
        mkdir -p "$INSTALL_DIR/tg"
        cp tg/*.py "$INSTALL_DIR/tg/"
    fi

    # Update shared/ library
    if [ -d "../shared" ]; then
        rm -rf "$INSTALL_DIR/shared"
        cp -r ../shared "$INSTALL_DIR/"
        echo "shared/ library updated."
    fi

    # Update casino-shared pip package
    if [ -f "$INSTALL_DIR/venv/bin/pip" ]; then
        "$INSTALL_DIR/venv/bin/pip" install --force-reinstall --no-cache-dir --quiet \
            "casino-shared @ git+https://github.com/snad1/casino-shared.git" 2>/dev/null && \
            echo "casino-shared pip package updated." || \
            echo "casino-shared pip update skipped (network issue)."
    fi

    # Self-update: copy this script to its installed location
    if [ -f "$SCRIPT_NAME" ]; then
        local installed repo_ver
        installed="$(command -v "$SCRIPT_NAME" 2>/dev/null || true)"
        if [ -n "$installed" ] && [ -f "$installed" ]; then
            cp "$SCRIPT_NAME" "$installed"
            chmod +x "$installed"
            echo "Updated $SCRIPT_NAME → $installed"
        fi
        # v3.6 — surface drift when the currently-executing wolfctl is older
        # than the repo copy. Chicken-and-egg: the OLD installed wolfctl won't
        # run this block at all, so on the FIRST upgrade the operator must
        # rerun `wolfctl update` (or `exec wolfctl update`) once to pick up
        # the new dispatcher. Subsequent runs self-heal.
        repo_ver="$(grep -m1 '^WOLFCTL_VERSION=' "$SCRIPT_NAME" 2>/dev/null | cut -d= -f2)"
        if [ -n "$repo_ver" ] && [ "$repo_ver" != "${WOLFCTL_VERSION:-unknown}" ]; then
            echo ""
            echo "  ⚠  wolfctl was stale: ${WOLFCTL_VERSION:-unknown} → $repo_ver"
            echo "     Re-run once to activate the new dispatcher:"
            echo "       exec wolfctl update"
            echo ""
        fi
    fi

    # v2.28.1 — migrate old Restart=always → Restart=on-failure so that
    # `wolfctl stop` and monitor's [S] stay stopped instead of triggering a
    # systemd respawn. Idempotent: subsequent runs find no match and skip.
    local _sd_reload=0
    for _unit in wolfbet.service wolfbet-tg.service wolfbet-web.service; do
        local _unit_path="$HOME/.config/systemd/user/$_unit"
        if [ -f "$_unit_path" ] && grep -q '^Restart=always$' "$_unit_path"; then
            sed -i.bak 's/^Restart=always$/Restart=on-failure/' "$_unit_path" \
                && rm -f "$_unit_path.bak" \
                && echo "Migrated $_unit: Restart=always → Restart=on-failure" \
                && _sd_reload=1
        fi
    done
    if [ "$_sd_reload" = "1" ]; then
        systemctl --user daemon-reload 2>/dev/null || true
    fi

    # Re-install deps
    "$INSTALL_DIR/venv/bin/pip" install --quiet -r "$INSTALL_DIR/requirements.txt"

    # Update web app if installed
    if [ -d "$WEB_DIR" ] && [ -d "web" ]; then
        mkdir -p "$WEB_DIR/web"
        cp -r web/* "$WEB_DIR/web/" 2>/dev/null || true
        [ -f "web/requirements.txt" ] && cp web/requirements.txt "$WEB_DIR/requirements.txt"
        "$WEB_DIR/venv/bin/pip" install --quiet -r "$WEB_DIR/requirements.txt" 2>/dev/null || true
        if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
            systemctl --user restart "$WEB_SERVICE"
            echo "Web admin updated + restarted."
        fi
    fi

    # Auto-restart TG bot if running
    if systemctl --user is-active --quiet "$TG_SERVICE" 2>/dev/null; then
        systemctl --user restart "$TG_SERVICE"
        sleep 1
        if systemctl --user is-active --quiet "$TG_SERVICE"; then
            echo "Updated + Telegram bot restarted."
        else
            echo "Updated but TG restart failed. Check: wolfctl tg logs"
        fi
    else
        echo "Updated. TG bot not running (skipped restart)."
    fi

    # v3.6 — auto-restart CLI daemon so the running process picks up the new
    # wolfbet.py. Before this, `wolfctl update` only refreshed the file on
    # disk and left the daemon on the pre-pull code until manual restart.
    # --resume preserves session state across the restart.
    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        systemctl --user restart "$SERVICE"
        sleep 1
        if systemctl --user is-active --quiet "$SERVICE"; then
            echo "CLI daemon restarted (session auto-resumed)."
        else
            echo "CLI restart failed. Check: wolfctl logs"
        fi
    else
        echo "  CLI bot: wolfctl restart"
    fi
}

# ── Telegram bot commands ────────────────────────────
cmd_tg() {
    local action="${1:-status}"
    case "$action" in
        start)
            if [ -f "$ENV_FILE" ]; then
                TOKEN=$(grep -E "^WOLFBET_TG_TOKEN=" "$ENV_FILE" | cut -d= -f2- | tr -d ' ')
                if [ -z "$TOKEN" ]; then
                    echo "Telegram token not set. Edit: wolfctl tg env"
                    exit 1
                fi
            else
                echo "No .env file found. Run installer or create: $ENV_FILE"
                exit 1
            fi
            systemctl --user start "$TG_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$TG_SERVICE"; then
                echo "Telegram bot started."
                echo "  Logs: wolfctl tg logs"
            else
                echo "Failed to start. Check: wolfctl tg logs"
                systemctl --user status "$TG_SERVICE" --no-pager 2>/dev/null || true
                exit 1
            fi
            ;;
        stop)
            systemctl --user stop "$TG_SERVICE"
            echo "Telegram bot stopped."
            ;;
        restart)
            systemctl --user restart "$TG_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$TG_SERVICE"; then
                echo "Telegram bot restarted."
            else
                echo "Failed to restart. Check: wolfctl tg logs"
                exit 1
            fi
            ;;
        status)
            echo ""
            echo "── Telegram Bot Service ──"
            systemctl --user status "$TG_SERVICE" --no-pager 2>/dev/null || echo "  Not running"
            echo ""
            if [ -f "$ENV_FILE" ]; then
                TOKEN=$(grep -E "^WOLFBET_TG_TOKEN=" "$ENV_FILE" | cut -d= -f2- | tr -d ' ')
                if [ -n "$TOKEN" ]; then
                    echo "  Token: ${TOKEN:0:10}…(set)"
                else
                    echo "  Token: NOT SET — run: wolfctl tg env"
                fi
            else
                echo "  .env: NOT FOUND"
            fi
            ;;
        logs)
            journalctl --user -u "$TG_SERVICE" -f --no-pager
            ;;
        logs-full)
            journalctl --user -u "$TG_SERVICE" -n 200 --no-pager
            ;;
        env)
            if [ ! -f "$ENV_FILE" ]; then
                cat > "$ENV_FILE" << 'INNEREOF'
# WolfBet AutoBot — Environment
WOLFBET_TG_TOKEN=
WOLFBET_TG_DATA=~/.wolfbot_tg
INNEREOF
            fi
            "${EDITOR:-nano}" "$ENV_FILE"
            echo "Restart Telegram bot to apply: wolfctl tg restart"
            ;;
        *)
            echo "Usage: wolfctl tg [start|stop|restart|status|logs|logs-full|env]"
            ;;
    esac
}

# ── All-services commands ────────────────────────────
cmd_start_all() {
    echo "Starting all services…"
    cmd_start 2>/dev/null || true
    cmd_tg start 2>/dev/null || true
    echo ""
    cmd_status_all
}

cmd_stop_all() {
    echo "Stopping all services…"
    systemctl --user stop "$SERVICE" 2>/dev/null || true
    systemctl --user stop "$TG_SERVICE" 2>/dev/null || true
    echo "All services stopped."
}

cmd_status_all() {
    echo ""
    echo "╔══════════════════════════════════════════╗"
    echo "║   WolfBet AutoBot — Service Status        ║"
    echo "╚══════════════════════════════════════════╝"
    echo ""

    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        echo "  CLI Bot:      ● RUNNING"
    else
        echo "  CLI Bot:      ○ stopped"
    fi

    if systemctl --user is-active --quiet "$TG_SERVICE" 2>/dev/null; then
        echo "  Telegram Bot: ● RUNNING"
    else
        echo "  Telegram Bot: ○ stopped"
    fi

    if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
        echo "  Web Admin:    ● RUNNING"
    else
        echo "  Web Admin:    ○ stopped"
    fi

    echo ""
}

cmd_web() {
    local action="${1:-status}"
    case "$action" in
        install)
            if [ -f "web/install.sh" ]; then
                bash web/install.sh --repo "$(pwd)" "${@:2}"
            else
                echo "web/install.sh not found. Run from the repo directory."
                exit 1
            fi
            ;;
        start)
            systemctl --user start "$WEB_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$WEB_SERVICE"; then
                echo "Web admin started."
            else
                echo "Failed to start. Check: wolfctl web logs"
                exit 1
            fi
            ;;
        stop)
            systemctl --user stop "$WEB_SERVICE"
            echo "Web admin stopped."
            ;;
        restart)
            systemctl --user restart "$WEB_SERVICE"
            sleep 1
            if systemctl --user is-active --quiet "$WEB_SERVICE"; then
                echo "Web admin restarted."
            else
                echo "Failed to restart. Check: wolfctl web logs"
                exit 1
            fi
            ;;
        status)
            echo ""
            echo "── Web Admin Status ──"
            systemctl --user status "$WEB_SERVICE" --no-pager 2>/dev/null || echo "  Service not running"
            ;;
        logs)
            journalctl --user -u "$WEB_SERVICE" -f --no-pager
            ;;
        logs-full)
            journalctl --user -u "$WEB_SERVICE" -n 200 --no-pager
            ;;
        update)
            if [ -d "web" ]; then
                echo "Updating web app files…"
                mkdir -p "$WEB_DIR/web"
                cp -r web/* "$WEB_DIR/web/" 2>/dev/null || true
                [ -f "web/requirements.txt" ] && cp web/requirements.txt "$WEB_DIR/requirements.txt"
                [ -f "$WEB_DIR/.env" ] || cp "$WEB_DIR/.env.example" "$WEB_DIR/.env" 2>/dev/null || true
                "$WEB_DIR/venv/bin/pip" install --quiet -r "$WEB_DIR/requirements.txt" 2>/dev/null || true
                if systemctl --user is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
                    systemctl --user restart "$WEB_SERVICE"
                    sleep 1
                    echo "Web admin updated + restarted."
                else
                    echo "Web admin updated. Start with: wolfctl web start"
                fi
            else
                echo "No web/ directory found."
                exit 1
            fi
            ;;
        *)
            echo "Usage: wolfctl web [install|start|stop|restart|status|logs|logs-full|update]"
            ;;
    esac
}

# ── Dispatch ─────────────────────────────────────────
case "${1:-}" in
    setup)        cmd_setup ;;
    start)        cmd_start ;;
    stop)         cmd_stop ;;
    restart)      cmd_restart ;;
    status)       cmd_status ;;
    monitor)      cmd_monitor ;;
    logs)         cmd_logs ;;
    logs-full)    cmd_logs_full ;;
    interactive)  cmd_interactive ;;
    tmux)         cmd_tmux ;;
    stats)        cmd_stats ;;
    session)      cmd_session "${2:-}" ;;
    presets)      cmd_presets ;;
    analytics)    cmd_analytics ;;
    last-bets)    cmd_last_bets "${2:-}" ;;
    export)       cmd_export "${2:-}" "${3:-}" ;;
    config-show)  cmd_config_show ;;
    config-set)   shift; cmd_config_set "$@" ;;
    pipeline)     cmd_pipeline "${2:-}" ;;
    backtest)     shift; cmd_backtest "$@" ;;
    preset)       cmd_preset "${2:-}" ;;
    cleanup)      cmd_cleanup "${2:-}" ;;
    benchmark)    cmd_benchmark "${2:-}" ;;
    diagnose)     cmd_diagnose ;;
    version|--version|-v) cmd_version ;;
    update)       cmd_update ;;
    tg)           cmd_tg "${2:-}" ;;
    web)          cmd_web "${@:2}" ;;
    start-all)    cmd_start_all ;;
    stop-all)     cmd_stop_all ;;
    status-all)   cmd_status_all ;;
    help|--help|-h) usage ;;
    *)            usage ;;
esac
exit
}
