# WolfBet Admin Web App: Configuration
# Copy to .env and fill both secrets. The app refuses to start with the
# shipped defaults or with a secret under 32 bytes / password under 12 chars.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

WOLFBET_WEB_SECRET_KEY=
WOLFBET_WEB_ADMIN_USER=admin
WOLFBET_WEB_ADMIN_PASS=
WOLFBET_WEB_HOST=127.0.0.1
WOLFBET_WEB_PORT=8002
WOLFBET_WEB_DEBUG=false

# Paths (defaults usually work)
# WOLFBET_WEB_DB_PATH=~/.wolfbet_web.db
# WOLFBET_WEB_BOT_DATA_DIR=~/.wolfbot_tg
# WOLFBET_WEB_INSTALL_DIR=~/wolfbet-bot
# WOLFBET_WEB_REPO_DIR=~/wolfbet

# Service names
# WOLFBET_WEB_SERVICE_CLI=wolfbet
# WOLFBET_WEB_SERVICE_TG=wolfbet-tg
# WOLFBET_WEB_SERVICE_WEB=wolfbet-web

# Telegram (optional: for generating auth deep links)
# WOLFBET_WEB_TG_BOT_TOKEN=
